@page "/seasons/{SeasonId:int}/rounds/create"
@attribute [Authorize]
@inject RoundService Service
@inject NavigationManager Navigation
@inject UserClock Clock

<PageTitle>New round</PageTitle>
@if (_loading)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_form is null)
{
    <NotFoundNotice Message="Season not found." />
}
else
{
    <MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-2">New round</MudText>
    <EditForm Model="_form" OnSubmit="SaveAsync">
        <MudPaper Class="pa-4" Style="max-width:40rem">
            <MudStack Spacing="2">
                @if (_errors.Summary is not null)
                {
                    <MudAlert Severity="Severity.Error">@_errors.Summary</MudAlert>
                }
                <RoundFields Form="_form" Errors="_errors" />
                <MudStack Row="true" Spacing="2">
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="_saving">Create</MudButton>
                    <MudButton Href="@($"/seasons/{SeasonId}/rounds")" Variant="Variant.Text">Cancel</MudButton>
                </MudStack>
            </MudStack>
        </MudPaper>
    </EditForm>
}

@code {
    private RoundForm? _form;
    private readonly FormErrors _errors = new();
    private bool _saving;
    private bool _loading = true;

    [Parameter]
    public int SeasonId { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _form = await Service.GetCreateFormAsync(SeasonId, Clock.Today);
        _loading = false;
    }

    private async Task SaveAsync()
    {
        if (_saving || _form is null)
        {
            return;
        }

        _saving = true;
        _errors.Clear();
        var result = await Service.CreateAsync(_form);
        _saving = false;
        if (result.IsSuccess)
        {
            Navigation.NavigateTo($"/rounds/details/{result.Value}");
            return;
        }

        _errors.Set(result.Error);
        if (result.Error.Kind == ErrorKind.NotFound)
        {
            _form = null;
        }
    }
}
