@page "/rounds/edit/{Id:int}"
@attribute [Authorize]
@inject RoundService Service
@inject NavigationManager Navigation

<PageTitle>Edit round</PageTitle>
@if (_loading)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_form is null)
{
    <NotFoundNotice Message="Round not found." />
}
else
{
    <MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-2">Edit round</MudText>
    <EditForm Model="_form" OnSubmit="SaveAsync">
        <MudPaper Class="pa-4" Style="max-width:40rem">
            <MudStack Spacing="2">
                @if (_conflict)
                {
                    <MudAlert Severity="Severity.Warning">
                        @_errors.Summary
                        <MudStack Row="true" Spacing="2" Class="mt-2">
                            <MudButton Variant="Variant.Outlined" OnClick="ReloadAsync">Reload</MudButton>
                            <MudButton Variant="Variant.Outlined" OnClick="ShowDifferencesAsync">Show differences</MudButton>
                        </MudStack>
                    </MudAlert>
                    @if (_current is not null)
                    {
                        <MudSimpleTable Dense="true" Style="overflow-x:auto">
                            <tbody>
                                <tr><th>Date</th><td>@_form.Date</td><td>@_current.Date</td></tr>
                                <tr><th>Number</th><td>@_form.Number</td><td>@_current.Number</td></tr>
                                <tr><th>Name</th><td>@_form.Name</td><td>@_current.Name</td></tr>
                                <tr><th>Venue</th><td>@_form.Venue</td><td>@_current.Venue</td></tr>
                                <tr><th>Status</th><td>@_form.Status</td><td>@_current.Status</td></tr>
                                <tr><th>Winning team</th><td>@_form.WinningTeam</td><td>@_current.WinningTeam</td></tr>
                                <tr><th>Winners</th><td>@string.Join(", ", _form.Winners)</td><td>@string.Join(", ", _current.Winners)</td></tr>
                            </tbody>
                        </MudSimpleTable>
                    }
                }
                else if (_errors.Summary is not null)
                {
                    <MudAlert Severity="Severity.Error">@_errors.Summary</MudAlert>
                }
                <RoundFields Form="_form" Errors="_errors" ShowResults="true" />
                <RoundWinnersFields SeasonId="_form.SeasonId" Form="_form" Errors="_errors" />
                <MudStack Row="true" Spacing="2">
                    <MudButton Href="@($"/seasons/{_form.SeasonId}/entries")" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Group">Season entries</MudButton>
                    <MudButton Href="/participants" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Person">Participants</MudButton>
                </MudStack>
                <MudTextField @bind-Value="_form.Note" Label="Note" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="3"
                              Error="@_errors.Has(nameof(RoundForm.Note))" ErrorText="@_errors.Text(nameof(RoundForm.Note))" />
                <MudStack Row="true" Spacing="2" Class="mt-2">
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="_saving">Save</MudButton>
                    <MudButton Href="@($"/rounds/details/{Id}")" Variant="Variant.Text">Cancel</MudButton>
                </MudStack>
            </MudStack>
        </MudPaper>
    </EditForm>
    <EventHistory RoundId="Id" />
}

@code {
    private RoundForm? _form;
    private RoundForm? _current;
    private readonly FormErrors _errors = new();
    private bool _loading = true;
    private bool _saving;
    private bool _conflict;

    [Parameter]
    public int Id { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _form = await Service.GetFormAsync(Id);
        _loading = false;
    }

    private async Task SaveAsync()
    {
        if (_saving || _form is null)
        {
            return;
        }

        _saving = true;
        _errors.Clear();
        _conflict = false;
        _current = null;
        var result = await Service.UpdateAsync(Id, _form);
        _saving = false;
        if (result.IsSuccess)
        {
            Navigation.NavigateTo($"/rounds/details/{result.Value}");
            return;
        }

        _errors.Set(result.Error);
        if (result.Error.Kind == ErrorKind.NotFound)
        {
            _form = null;
        }
        else
        {
            _conflict = result.Error.Kind == ErrorKind.Conflict;
        }
    }

    private async Task ReloadAsync()
    {
        _errors.Clear();
        _conflict = false;
        _current = null;
        _form = await Service.GetFormAsync(Id);
    }

    private async Task ShowDifferencesAsync() => _current = await Service.GetFormAsync(Id);
}
