@inject LookupCache Lookups

<FuzzySelect T="SeasonEntryOption" Value="_selectedTeam" ValueChanged="TeamChangedAsync"
             Items="_entries" Text="EntryText" Label="Winning team"
             Error="@Errors.Has(nameof(RoundForm.WinningTeam))"
             ErrorText="@Errors.Text(nameof(RoundForm.WinningTeam))" />
<FuzzyMultiSelect T="ParticipantOption" Values="_selectedWinners" ValuesChanged="WinnersChangedAsync"
                  Items="_participants" Text="ParticipantText" Keys="ParticipantKeys"
                  ItemTemplate="ParticipantTemplate" Label="Winning participants" MaxSelected="4"
                  Error="@Errors.Has(nameof(RoundForm.Winners))"
                  ErrorText="@Errors.Text(nameof(RoundForm.Winners))" />

@code {
    private IReadOnlyList<SeasonEntryOption> _entries = [];
    private IReadOnlyList<ParticipantOption> _participants = [];
    private IReadOnlyList<ParticipantOption> _selectedWinners = [];
    private SeasonEntryOption? _selectedTeam;

    [Parameter, EditorRequired]
    public int SeasonId { get; set; }

    [Parameter, EditorRequired]
    public RoundForm Form { get; set; } = default!;

    [Parameter, EditorRequired]
    public FormErrors Errors { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(
            Lookups.RevalidateAsync(LookupKind.Participants),
            Lookups.RevalidateAsync(LookupKind.SeasonEntries)
        );
        _participants = await Lookups.GetParticipantsAsync();
        _entries = (await Lookups.GetSeasonEntriesAsync())
            .Where(entry => entry.SeasonId.Value == SeasonId)
            .ToArray();
        SyncSelection();
    }

    protected override void OnParametersSet() => SyncSelection();

    private void SyncSelection()
    {
        _selectedTeam = _entries.FirstOrDefault(entry => entry.TeamId.Value == Form.WinningTeam);
        var winners = Form.Winners.ToHashSet();
        _selectedWinners = _participants.Where(participant => winners.Contains(participant.Id.Value)).ToArray();
    }

    private static string EntryText(SeasonEntryOption entry) =>
        CountryFlag.WithName(entry.Country.Value, entry.Name);

    private static string ParticipantText(ParticipantOption participant) =>
        $"{participant.FirstName} {participant.LastName}";

    private static string[] ParticipantKeys(ParticipantOption participant) =>
        [$"{participant.FirstName} {participant.LastName}", $"{participant.LastName} {participant.FirstName}"];

    private bool HasDuplicateName(ParticipantOption participant) =>
        _participants.Count(candidate =>
            candidate.FirstName == participant.FirstName && candidate.LastName == participant.LastName
        ) > 1;

    private RenderFragment<ParticipantOption> ParticipantTemplate =>
        participant => builder =>
        {
            builder.OpenElement(0, "div");
            builder.OpenElement(1, "span");
            builder.AddContent(2, ParticipantText(participant));
            builder.CloseElement();
            if (HasDuplicateName(participant))
            {
                builder.OpenElement(3, "span");
                builder.AddAttribute(4, "class", "mud-typography mud-typography-caption mud-text-secondary ml-2");
                builder.AddContent(5, participant.CountryName);
                builder.CloseElement();
            }

            builder.CloseElement();
        };

    private Task TeamChangedAsync(SeasonEntryOption? team)
    {
        _selectedTeam = team;
        Form.WinningTeam = team?.TeamId.Value;
        return Task.CompletedTask;
    }

    private Task WinnersChangedAsync(IReadOnlyList<ParticipantOption> winners)
    {
        _selectedWinners = winners;
        Form.Winners = winners.Select(participant => participant.Id.Value).ToList();
        return Task.CompletedTask;
    }
}
