@inject LookupCache Lookups

@if (EditMode)
{
    @if (_selectedTeam is not null)
    {
        <MudTextField Value="@TeamText(_selectedTeam)" Label="Team" ReadOnly="true" />
    }
}
else
{
    <FuzzySelect T="TeamOption" Value="_selectedTeam" ValueChanged="TeamChangedAsync" Items="_availableTeams"
                 Text="TeamText" Keys="TeamKeys" Label="Team" Required="true" RequiredError="Select a team."
                 Error="@Errors.Has(nameof(SeasonEntryForm.TeamId))"
                 ErrorText="@Errors.Text(nameof(SeasonEntryForm.TeamId))" />
}
<MudTextField @bind-Value="Form.Name" Label="Name during this season" Required="true" Immediate="true"
              MaxLength="@SeasonEntryFormValidator.MaxNameLength"
              Error="@Errors.Has(nameof(SeasonEntryForm.Name))" ErrorText="@Errors.Text(nameof(SeasonEntryForm.Name))" />

@if (_selectedTeam is not null)
{
    <MudPaper Class="pa-3" Outlined="true">
        <MudText Typo="Typo.subtitle1">Team history</MudText>
        <MudText Typo="Typo.body2">Original team name: @_selectedTeam.Name</MudText>
        @if (_selectedTeam.History.Length > 0)
        {
            <MudText Typo="Typo.body2">
                Latest season: @_selectedTeam.History[0].SeasonLabel — @_selectedTeam.History[0].Name
            </MudText>
            <MudList T="string" Dense="true">
                @foreach (var entry in _selectedTeam.History)
                {
                    <MudListItem Value="@entry.Name">
                        @entry.SeasonLabel — @entry.Name
                    </MudListItem>
                }
            </MudList>
        }
        else
        {
            <MudText Typo="Typo.body2">No previous season entries.</MudText>
        }
    </MudPaper>
}

@code {
    private IReadOnlyList<TeamOption> _teams = [];
    private IReadOnlyList<TeamOption> _availableTeams = [];
    private TeamOption? _selectedTeam;

    [Parameter, EditorRequired]
    public SeasonEntryContext Season { get; set; } = default!;

    [Parameter, EditorRequired]
    public SeasonEntryForm Form { get; set; } = default!;

    [Parameter, EditorRequired]
    public FormErrors Errors { get; set; } = default!;

    [Parameter]
    public bool EditMode { get; set; }

    protected override void OnParametersSet()
    {
        _selectedTeam = _teams.FirstOrDefault(team => team.Id.Value == Form.TeamId);
        _availableTeams = _teams.Where(team => team.Sport == Season.Sport).ToArray();
    }

    protected override async Task OnInitializedAsync()
    {
        await Lookups.RevalidateAsync(LookupKind.Teams);
        _teams = await Lookups.GetTeamsAsync();
        OnParametersSet();
    }

    private static string TeamText(TeamOption team) =>
        team.History.Length == 0 ? team.Name : string.IsNullOrEmpty(team.History[0].SeasonLabel)
            ? $"{team.Name} ({team.History[0].Name})"
            : $"{team.Name} ({team.History[0].SeasonLabel} - {team.History[0].Name})";

    private static string[] TeamKeys(TeamOption team) =>
        [team.Name, .. team.History.Select(entry => entry.Name)];

    private Task TeamChangedAsync(TeamOption? team)
    {
        _selectedTeam = team;
        Form.TeamId = team?.Id.Value;
        if (string.IsNullOrWhiteSpace(Form.Name) && team is not null)
        {
            Form.Name = team.LatestEntryName;
        }

        return Task.CompletedTask;
    }
}
