@page "/season-entries/edit/{SeasonId:int}/{TeamId:int}"
@attribute [Authorize]
@inject SeasonEntryService Service
@inject NavigationManager Navigation

<PageTitle>Edit season entry</PageTitle>
@if (_loading)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_form is null || _season is null)
{
    <NotFoundNotice Message="Season entry not found." />
}
else
{
    <MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-2">Edit season entry — @_season.Sport @_season.Label</MudText>
    <EditForm Model="_form" OnSubmit="SaveAsync">
        <MudPaper Class="pa-4" Style="max-width:40rem">
            <MudStack Spacing="2">
                @if (_conflict)
                {
                    <MudAlert Severity="Severity.Warning">
                        @_errors.Summary
                        <MudButton Variant="Variant.Outlined" OnClick="ReloadAsync" Class="mt-2">Reload</MudButton>
                    </MudAlert>
                }
                else if (_errors.Summary is not null)
                {
                    <MudAlert Severity="Severity.Error">@_errors.Summary</MudAlert>
                }
                <SeasonEntryFields Season="_season" Form="_form" Errors="_errors" EditMode="true" />
                <MudStack Row="true" Spacing="2">
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="_saving">Save</MudButton>
                    <MudButton Href="@($"/seasons/{SeasonId}/entries")" Variant="Variant.Text">Cancel</MudButton>
                </MudStack>
            </MudStack>
        </MudPaper>
    </EditForm>
}

@code {
    private SeasonEntryContext? _season;
    private SeasonEntryForm? _form;
    private readonly FormErrors _errors = new();
    private bool _loading = true;
    private bool _saving;
    private bool _conflict;

    [Parameter]
    public int SeasonId { get; set; }

    [Parameter]
    public int TeamId { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _season = await Service.GetSeasonAsync(SeasonId);
        _form = await Service.GetFormAsync(SeasonId, TeamId);
        _loading = false;
    }

    private async Task SaveAsync()
    {
        if (_saving || _form is null)
        {
            return;
        }

        _saving = true;
        _errors.Clear();
        _conflict = false;
        var result = await Service.UpdateAsync(SeasonId, TeamId, _form);
        _saving = false;
        if (result.IsSuccess)
        {
            Navigation.NavigateTo($"/season-entries/details/{SeasonId}/{TeamId}");
            return;
        }

        _errors.Set(result.Error);
        if (result.Error.Kind == ErrorKind.NotFound)
        {
            _form = null;
        }
        else
        {
            _conflict = result.Error.Kind == ErrorKind.Conflict;
        }
    }

    private async Task ReloadAsync()
    {
        _errors.Clear();
        _conflict = false;
        _form = await Service.GetFormAsync(SeasonId, TeamId);
    }
}
