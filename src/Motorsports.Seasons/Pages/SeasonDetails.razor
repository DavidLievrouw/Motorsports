@page "/seasons/details/{Id:int}"
@attribute [Authorize]
@inject SeasonService Service

<PageTitle>Season</PageTitle>
@if (_loading)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_season is null)
{
    <NotFoundNotice Message="Season not found." />
}
else
{
    <MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-2">@($"{_season.Sport} {_season.Label}".Trim())</MudText>
    <MudPaper Class="pa-4 mb-2" Style="max-width:48rem">
        <MudSimpleTable Dense="true" Style="overflow-x:auto">
            <tbody>
                <tr><th>Sport</th><td>@_season.SportFullName (@_season.Sport)</td></tr>
                <tr><th>Label</th><td>@(_season.Label ?? "—")</td></tr>
                <tr><th>Start date</th><td>@DateDisplay.Format(_season.StartDate)</td></tr>
                <tr><th>End date</th><td>@DateDisplay.Format(_season.EndDate)</td></tr>
                <tr><th>Season entries</th><td>@_season.SeasonEntryCount</td></tr>
                <tr><th>Rounds</th><td>@_season.RoundCount</td></tr>
                <tr><th>Winning team</th><td>@(_season.WinningTeamName ?? "—")</td></tr>
                <tr><th>Winning participants</th><td>@(_season.WinningParticipants.Length == 0 ? "—" : string.Join(", ", _season.WinningParticipants))</td></tr>
            </tbody>
        </MudSimpleTable>
    </MudPaper>
    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2">
        <MudButton Href="@($"/seasons/edit/{Id}")" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit">Edit</MudButton>
        <MudButton Href="@($"/seasons/{Id}/entries")" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Groups">Season entries</MudButton>
        <MudButton Href="@($"/seasons/delete/{Id}")" Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete">Delete</MudButton>
        <MudButton Href="/seasons" Variant="Variant.Text">Back to seasons</MudButton>
    </MudStack>
}

@code {
    private SeasonInfo? _season;
    private bool _loading = true;

    [Parameter]
    public int Id { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _season = await Service.GetAsync(Id);
        _loading = false;
    }
}
