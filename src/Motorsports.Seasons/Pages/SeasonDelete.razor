@page "/seasons/delete/{Id:int}"
@attribute [Authorize]
@inject SeasonService Service
@inject NavigationManager Navigation

<PageTitle>Delete season</PageTitle>
@if (_loading)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_season is null)
{
    <NotFoundNotice Message="Season not found." />
}
else
{
    <MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-2">Delete season</MudText>
    <MudPaper Class="pa-4" Style="max-width:40rem">
        <MudStack Spacing="2">
            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error">@_error</MudAlert>
            }
            @if (_season.RoundCount > 0)
            {
                <MudAlert Severity="Severity.Warning">@SeasonService.HasRoundsMessage</MudAlert>
            }
            else
            {
                <MudAlert Severity="Severity.Warning">
                    Delete season <strong>@_season.Label</strong>? This will also delete @_season.EntryCount season entries
                    and @_season.WinnerCount season-winner links. This cannot be undone.
                </MudAlert>
            }
            <MudStack Row="true" Spacing="2">
                <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="DeleteAsync"
                           Disabled="@(_saving || _season.RoundCount > 0)">Delete</MudButton>
                <MudButton Href="@($"/seasons/details/{Id}")" Variant="Variant.Text">Cancel</MudButton>
            </MudStack>
        </MudStack>
    </MudPaper>
}

@code {
    private SeasonDeleteInfo? _season;
    private bool _loading = true;
    private bool _saving;
    private string? _error;

    [Parameter]
    public int Id { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _season = await Service.GetDeleteInfoAsync(Id);
        _loading = false;
    }

    private async Task DeleteAsync()
    {
        if (_saving)
        {
            return;
        }

        _saving = true;
        _error = null;
        var result = await Service.DeleteAsync(Id);
        _saving = false;
        if (result.IsSuccess)
        {
            Navigation.NavigateTo("/seasons");
            return;
        }

        _error = result.Error.Message;
        if (result.Error.Kind == ErrorKind.NotFound)
        {
            _season = null;
        }
        else
        {
            _season = await Service.GetDeleteInfoAsync(Id);
        }
    }
}
