@page "/account/change-password"
@layout AuthLayout
@attribute [Authorize]
@attribute [ExcludeFromInteractiveRouting]
@using Microsoft.AspNetCore.Identity
@using FluentValidation
@using Motorsports.Infrastructure.Entities
@inject UserManager<User> UserManager
@inject SignInManager<User> SignInManager
@inject IValidator<ChangePasswordModel> Validator
@inject NavigationManager Navigation

<PageTitle>Change password</PageTitle>

<h1>Change password</h1>

@if (_forced)
{
    <p>You must choose a new password before you continue.</p>
}

@if (_errors.Count > 0)
{
    <ul class="auth-error" role="alert">
        @foreach (var error in _errors)
        {
            <li>@error</li>
        }
    </ul>
}

<EditForm Model="Model" FormName="change-password" OnSubmit="SubmitAsync" method="post">
    <input type="hidden" name="ReturnUrl" value="@(LocalUrl.IsLocal(ReturnUrl) ? ReturnUrl : "")" />
    <label for="current">Current password</label>
    <InputText id="current" type="password" autocomplete="current-password" maxlength="256" @bind-Value="Model.CurrentPassword" />
    <label for="new">New password</label>
    <InputText id="new" type="password" autocomplete="new-password" maxlength="256" @bind-Value="Model.NewPassword" />
    <label for="confirm">Confirm new password</label>
    <InputText id="confirm" type="password" autocomplete="new-password" maxlength="256" @bind-Value="Model.ConfirmPassword" />
    <button type="submit">Change password</button>
</EditForm>

@code {
    private readonly List<string> _errors = [];
    private bool _forced;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private ChangePasswordModel Model { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromForm(Name = "ReturnUrl")]
    private string? PostedReturnUrl { get; set; }

    protected override void OnInitialized()
    {
        Model ??= new();
        _forced = HttpContext.User.HasClaim(Motorsports.Infrastructure.Auth.AppClaimTypes.ForceChangePassword, "true");
    }

    private async Task SubmitAsync()
    {
        _errors.Clear();
        var validation = await Validator.ValidateAsync(Model);
        if (!validation.IsValid)
        {
            _errors.AddRange(validation.Errors.Select(e => e.ErrorMessage).Distinct());
            Model = new();
            return;
        }

        var user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            Navigation.NavigateTo(AuthEndpoints.LoginPath, forceLoad: true);
            return;
        }

        var result = await UserManager.ChangePasswordAsync(user, Model.CurrentPassword!, Model.NewPassword!);
        if (!result.Succeeded)
        {
            // Never reveal more than needed: a wrong current password has one fixed message.
            _errors.AddRange(
                result.Errors.Select(e => e.Code == "PasswordMismatch" ? "The current password is incorrect." : e.Description)
            );
            Model = new();
            return;
        }

        if (user.ForceChangePassword)
        {
            user.ForceChangePassword = false;
            await UserManager.UpdateAsync(user);
        }

        await SignInManager.RefreshSignInAsync(user);
        Navigation.NavigateTo(LocalUrl.OrDefault(PostedReturnUrl ?? ReturnUrl), forceLoad: true);
    }
}