@page "/account/change-password"
@attribute [Authorize]
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Change password</PageTitle>

<div class="auth-shell auth-embedded"><div class="auth-card">
<h1>Change password</h1>

@if (_forced)
{
    <p>You must choose a new password before you continue.</p>
}

@if (ErrorMessage is not null)
{
    <ul class="auth-error" role="alert">
        <li>@ErrorMessage</li>
    </ul>
}

<form method="post" action="@AuthEndpoints.ChangePasswordPath">
    <AntiforgeryToken />
    <input type="hidden" name="ReturnUrl" value="@(LocalUrl.IsLocal(ReturnUrl) ? ReturnUrl : "")" />
    <label for="current">Current password</label>
    <input id="current" name="CurrentPassword" type="password" autocomplete="current-password" maxlength="256" required />
    <label for="new">New password</label>
    <input id="new" name="NewPassword" type="password" autocomplete="new-password" maxlength="256" required />
    <label for="confirm">Confirm new password</label>
    <input id="confirm" name="ConfirmPassword" type="password" autocomplete="new-password" maxlength="256" required />
    <button type="submit">Change password</button>
</form>
</div></div>

@code {
    private bool _forced;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery]
    private string? Error { get; set; }

    private string? ErrorMessage =>
        Error switch
        {
            "invalid" => "Review the password requirements and try again.",
            "current" => "The current password is incorrect.",
            "failed" => "The password could not be changed. Check the requirements and try again.",
            _ => null,
        };

    protected override async Task OnInitializedAsync()
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _forced = authenticationState.User.HasClaim(
            Motorsports.Infrastructure.Auth.AppClaimTypes.ForceChangePassword,
            "true"
        );
    }
}