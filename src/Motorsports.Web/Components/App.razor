<!DOCTYPE html>
<html lang="en" data-theme="@(DarkMode
                                ? "dark"
                                : "light")">

<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <base href="/"/>
    <ResourcePreloader/>
    <link rel="stylesheet" href="@Assets["_content/MudBlazor/MudBlazor.min.css"]"/>
    <link rel="stylesheet" href="@Assets["app.css"]"/>
    <link rel="stylesheet" href="@Assets["Motorsports.Web.styles.css"]"/>
    <link rel="stylesheet" href="@Assets["_content/Motorsports.Auth/auth.css"]"/>
    <ImportMap nonce="@CspNonce"/>
    <link rel="icon" type="image/png" href="favicon.png"/>
    <HeadOutlet @rendermode="PageRenderMode"/>
</head>

<body>
<Routes @rendermode="PageRenderMode" DarkMode="DarkMode"/>
<ReconnectModal/>
<script nonce="@CspNonce" src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
<script nonce="@CspNonce" src="@Assets["_framework/blazor.web.js"]"></script>
<script nonce="@CspNonce" src="@Assets["app.js"]"></script>
</body>

</html>

@code {

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    // Anonymous auth pages stay static; password changes use a form POST endpoint to update the auth cookie.
    private IComponentRenderMode? PageRenderMode => HttpContext?.AcceptsInteractiveRouting() == false
        ? null
        : InteractiveServer;

    // Dark unless the user picked light (cookie written by app.js).
    private bool DarkMode => HttpContext?.Request.Cookies["theme"] != "light";

    private string? CspNonce => HttpContext?.Items["CspNonce"] as string;
}
