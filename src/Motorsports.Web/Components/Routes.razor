<Router AppAssembly="typeof(Program).Assembly" AdditionalAssemblies="[typeof(Motorsports.Auth.AuthOptions).Assembly]" NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        <CascadingValue Value="DarkMode" Name="InitialDarkMode">
            <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
                <NotAuthorized>
                    <RedirectToLogin />
                </NotAuthorized>
            </AuthorizeRouteView>
        </CascadingValue>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>

@code {
    [Parameter]
    public bool DarkMode { get; set; } = true;
}