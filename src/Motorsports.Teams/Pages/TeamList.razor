@page "/teams"
@attribute [Authorize]
@inject TeamService Service
@inject NavigationManager Navigation

<PageTitle>Teams</PageTitle>

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
    <MudText Typo="Typo.h4" HtmlTag="h1">Teams</MudText>
    <MudButton Href="/teams/create" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add">New team</MudButton>
</MudStack>

<MudTextField T="string" @bind-Value="_search" @bind-Value:after="SearchAsync" Label="Search" Immediate="true"
              DebounceInterval="300" Clearable="true" OnKeyDown="OnKeyDown" Class="mb-2" Style="max-width:24rem" />

@if (_result is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    <MudDataGrid T="TeamRow" RowClass="sport-accent-row" RowStyleFunc="@((item, _) => SportAccent.RowStyle(item.Sport.Value))" Items="_result.Items" Dense="true" Hover="true" Striped="true" Bordered="true" Elevation="1">
        <Columns>
            <PropertyColumn Property="team => team.Name" Title="Name" />
            <TemplateColumn Title="Sport">
                <CellTemplate>
                    <MudStack Row="true" AlignItems="AlignItems.Center">
                        <MudImage Src="@SportImage.Url(context.Item.Sport.Value)" Alt="@($"{context.Item.Sport} logo")"
                                  Width="28" Height="22" ObjectFit="ObjectFit.Contain" />
                        <span>@context.Item.Sport</span>
                    </MudStack>
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="team => team.CountryName" Title="Country"><CellTemplate>@CountryFlag.WithName(context.Item.Country.Value, context.Item.CountryName)</CellTemplate></PropertyColumn>
            <TemplateColumn Title="Actions" Sortable="false">
                <CellTemplate>
                    <MudButton Href="@($"/teams/details/{context.Item.Id}")" Size="Size.Small" StartIcon="@Icons.Material.Filled.Visibility">Details</MudButton>
                    <MudButton Href="@($"/teams/edit/{context.Item.Id}")" Size="Size.Small" StartIcon="@Icons.Material.Filled.Edit">Edit</MudButton>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </MudDataGrid>
    @if (_result.PageCount > 1)
    {
        <MudPagination Class="mt-2" Count="_result.PageCount" Selected="_result.Page" SelectedChanged="GoToPage" />
    }
}

@code {
    private PagedResult<TeamRow>? _result;
    private string? _search;

    [SupplyParameterFromQuery(Name = "q")]
    public string? Query { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    public int? PageNumber { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (Paging.NormalizeSearch(_search) != Paging.NormalizeSearch(Query))
        {
            _search = Query;
        }

        _result = await Service.ListAsync(Query, PageNumber ?? 1);
    }

    private void OnKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            Search();
        }
    }

    private Task SearchAsync()
    {
        if (Paging.NormalizeSearch(_search) != Paging.NormalizeSearch(Query))
        {
            Search();
        }

        return Task.CompletedTask;
    }

    private void Search() => Navigation.NavigateTo(Url(Paging.NormalizeSearch(_search), 1), replace: true);

    private void GoToPage(int page) => Navigation.NavigateTo(Url(Paging.NormalizeSearch(Query), page));

    private static string Url(string? q, int page)
    {
        var url = "/teams";
        var parts = new List<string>();
        if (q is not null)
        {
            parts.Add("q=" + Uri.EscapeDataString(q));
        }

        if (page > 1)
        {
            parts.Add("page=" + page);
        }

        return parts.Count == 0 ? url : url + "?" + string.Join('&', parts);
    }
}