@page "/teams/details/{Id:int}"
@attribute [Authorize]
@inject TeamService Service

<PageTitle>Team</PageTitle>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_team is null)
{
    <NotFoundNotice Message="Team not found." />
}
else
{
    <MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-2">@_team.Name</MudText>
    <MudPaper Class="pa-4 mb-2" Style="max-width:40rem">
        <MudSimpleTable Dense="true" Style="overflow-x:auto">
            <tbody>
                <tr><th>Name</th><td>@_team.Name</td></tr>
                <tr><th>Sport</th><td><MudStack Row="true" AlignItems="AlignItems.Center" Class="pl-2" Style="@SportAccent.Style(_team.Sport)"><MudImage Src="@SportImage.Url(_team.Sport)" Alt="@($"{_team.Sport} logo")" Width="32" Height="24" ObjectFit="ObjectFit.Contain" />@_team.Sport</MudStack></td></tr>
                <tr><th>Country</th><td>@CountryFlag.WithName(_team.Country, _team.CountryName)</td></tr>
                <tr><th>Season entries</th><td>@_team.SeasonEntryCount</td></tr>
            </tbody>
        </MudSimpleTable>
    </MudPaper>
    <MudText Typo="Typo.h5" HtmlTag="h2" Class="mt-4 mb-2">Season wins</MudText>
    @if (_team.SeasonWins.Length == 0)
    {
        <MudText Class="mb-4">No season wins.</MudText>
    }
    else
    {
        <MudDataGrid T="TeamSeasonWin" RowClass="sport-accent-row" RowStyleFunc="@((item, _) => SportAccent.RowStyle(item.Sport))" Items="_team.SeasonWins" Dense="true" Hover="true" Striped="true" Bordered="true" Elevation="1" Class="mb-2">
            <Columns>
                <TemplateColumn Title="Season">
                    <CellTemplate>
                        <MudStack Row="true" AlignItems="AlignItems.Center">
                            <MudImage Src="@SportImage.Url(context.Item.Sport)" Alt="@($"{context.Item.Sport} logo")"
                                      Width="28" Height="22" ObjectFit="ObjectFit.Contain" />
                            <MudLink Href="@($"/seasons/details/{context.Item.SeasonId}")">
                                @($"{context.Item.Sport} {context.Item.Label} ({DateDisplay.Format(context.Item.StartDate)} – {DateDisplay.Format(context.Item.EndDate)})".Trim())
                            </MudLink>
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </MudDataGrid>
    }
    <MudStack Row="true" Spacing="2">
        <MudButton Href="@($"/teams/edit/{_team.Id}")" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit">Edit</MudButton>
        @if (_team.SeasonEntryCount == 0)
        {
            <MudButton Href="@($"/teams/delete/{_team.Id}")" Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete">Delete</MudButton>
        }
        <MudButton Href="/teams" Variant="Variant.Text">Back to teams</MudButton>
    </MudStack>
}

@code {
    private TeamInfo? _team;
    private bool _loading = true;

    [Parameter]
    public int Id { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _team = await Service.GetAsync(Id);
        _loading = false;
    }
}