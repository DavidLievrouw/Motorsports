@page "/venues/details/{Name}"
@attribute [Authorize]
@inject VenueService Service
@using System.Globalization
@using Motorsports.Common.Images

<PageTitle>Venue</PageTitle>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_venue is null)
{
    <NotFoundNotice Message="Venue not found." />
}
else
{
    <MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-2">@_venue.Name</MudText>
    <MudPaper Class="pa-4 mb-2" Style="max-width:40rem">
        <MudSimpleTable Dense="true" Style="overflow-x:auto">
            <tbody>
                <tr><th>Name</th><td>@_venue.Name</td></tr>
                <tr><th>Country</th><td>@CountryFlag.WithName(_venue.Country, _venue.CountryName)</td></tr>
                <tr><th>Rounds</th><td>@_venue.RoundCount</td></tr>
            </tbody>
        </MudSimpleTable>
    </MudPaper>
    <MudText Typo="Typo.h5" HtmlTag="h2" Class="mb-2">Rounds at this venue</MudText>
    @if (_venue.Rounds.Count == 0)
    {
        <MudText>No rounds are associated with this venue.</MudText>
    }
    else
    {
        <MudDataGrid T="VenueRoundInfo" Items="_venue.Rounds" Dense="true" Hover="true" Striped="true"
                     Bordered="true" Elevation="1" Class="mb-4">
            <Columns>
                <TemplateColumn Title="Date" Sortable="false">
                    <CellTemplate>@context.Item.Date.ToString("MMMM d, yyyy", CultureInfo.InvariantCulture)</CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Sport" Sortable="false">
                    <CellTemplate>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            @if (context.Item.SportHasImage)
                            {
                                <MudImage Src="@SportImage.Url(context.Item.Sport)" Alt="@($"{context.Item.Sport} logo")" Width="40" Height="30" ObjectFit="ObjectFit.Contain" />
                            }
                            <MudText>@context.Item.Sport</MudText>
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="round => round.Label" Title="Round" />
                <TemplateColumn Title="Winners" Sortable="false">
                    <CellTemplate>@(context.Item.WinningParticipants.Count == 0 ? "—" : string.Join(", ", context.Item.WinningParticipants))</CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Winning team" Sortable="false">
                    <CellTemplate>@(context.Item.WinningTeamName ?? "—")</CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="round => round.Status" Title="Status" />
                <TemplateColumn Title="Rating" Sortable="false">
                    <CellTemplate>@(context.Item.Rating is { } rating ? $"{rating.ToString("0", CultureInfo.InvariantCulture)} / 10" : "—")</CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Rain" Sortable="false">
                    <CellTemplate>@(context.Item.Rain ?? "—")</CellTemplate>
                </TemplateColumn>
            </Columns>
        </MudDataGrid>
    }
    <MudStack Row="true" Spacing="2">
        <MudButton Href="@($"/venues/edit/{Uri.EscapeDataString(_venue.Name)}")" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit">Edit</MudButton>
        <MudButton Href="/venues" Variant="Variant.Text">Back to venues</MudButton>
    </MudStack>
}

@code {
    private VenueInfo? _venue;
    private bool _loading = true;

    [Parameter]
    public string Name { get; set; } = "";

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _venue = await Service.GetAsync(Name);
        _loading = false;
    }
}