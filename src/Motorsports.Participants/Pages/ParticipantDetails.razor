@page "/participants/details/{Id:int}"
@attribute [Authorize]
@inject ParticipantService Service

<PageTitle>Participant</PageTitle>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_participant is null)
{
    <NotFoundNotice Message="Participant not found." />
}
else
{
    <MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-2">@($"{_participant.Title} {_participant.FirstName} {_participant.LastName}".Trim())</MudText>
    <MudPaper Class="pa-4 mb-2" Style="max-width:40rem">
        <MudSimpleTable Dense="true" Style="overflow-x:auto">
            <tbody>
                <tr><th>Title</th><td>@_participant.Title</td></tr>
                <tr><th>First name</th><td>@_participant.FirstName</td></tr>
                <tr><th>Last name</th><td>@_participant.LastName</td></tr>
                <tr><th>Country</th><td>@CountryFlag.WithName(_participant.Country, _participant.CountryName)</td></tr>
                <tr><th>Sports</th><td>@(_participant.Sports.Length == 0 ? "—" : string.Join(", ", _participant.Sports))</td></tr>
            </tbody>
        </MudSimpleTable>
    </MudPaper>
    <MudStack Row="true" Spacing="2">
        <MudButton Href="@($"/participants/edit/{_participant.Id}")" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit">Edit</MudButton>
        <MudButton Href="/participants" Variant="Variant.Text">Back to participants</MudButton>
    </MudStack>
}

@code {
    private ParticipantInfo? _participant;
    private bool _loading = true;

    [Parameter]
    public int Id { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _participant = await Service.GetAsync(Id);
        _loading = false;
    }
}