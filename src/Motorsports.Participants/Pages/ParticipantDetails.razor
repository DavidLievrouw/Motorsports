@page "/participants/details/{Id:int}"
@attribute [Authorize]
@inject ParticipantService Service

<PageTitle>Participant</PageTitle>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_participant is null)
{
    <NotFoundNotice Message="Participant not found." />
}
else
{
    <MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-2">@($"{_participant.Title} {_participant.FirstName} {_participant.LastName}".Trim())</MudText>
    <MudPaper Class="pa-4 mb-2" Style="max-width:40rem">
        <MudSimpleTable Dense="true" Style="overflow-x:auto">
            <tbody>
                <tr><th>Title</th><td>@_participant.Title</td></tr>
                <tr><th>First name</th><td>@_participant.FirstName</td></tr>
                <tr><th>Last name</th><td>@_participant.LastName</td></tr>
                <tr><th>Country</th><td>@CountryFlag.WithName(_participant.Country.Value, _participant.CountryName)</td></tr>
                <tr><th>Sports</th><td>@(_participant.Sports.Length == 0 ? "—" : string.Join(", ", _participant.Sports))</td></tr>
            </tbody>
        </MudSimpleTable>
    </MudPaper>
    <MudText Typo="Typo.h5" HtmlTag="h2" Class="mt-4 mb-2">Round wins</MudText>
    @if (_participant.RoundWins.Length == 0)
    {
        <MudText>No round wins.</MudText>
    }
    else
    {
        <MudDataGrid T="ParticipantRoundWin" RowClass="sport-accent-row" RowStyleFunc="@((item, _) => SportAccent.RowStyle(item.Sport.Value))" Items="_participant.RoundWins" Dense="true" Hover="true" Striped="true" Bordered="true" Elevation="1" Class="mb-2">
            <Columns>
                <TemplateColumn Title="Date">
                    <CellTemplate>@DateDisplay.Format(context.Item.Date)</CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Sport / season">
                    <CellTemplate>
                        <MudStack Row="true" AlignItems="AlignItems.Center">
                            <MudImage Src="@SportImage.Url(context.Item.Sport.Value)" Alt="@($"{context.Item.Sport} logo")"
                                      Width="28" Height="22" ObjectFit="ObjectFit.Contain" />
                            <span>@($"{context.Item.Sport} {context.Item.SeasonLabel}".Trim())</span>
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Round">
                    <CellTemplate>
                        <MudLink Href="@($"/rounds/details/{context.Item.RoundId}")">
                            Round @RoundLabel.Format(context.Item.Number, context.Item.Name)
                        </MudLink>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Venue">
                    <CellTemplate>@CountryFlag.WithName(context.Item.VenueCountry.Value, context.Item.Venue.Value)</CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Rating">
                    <CellTemplate>@RatingDisplay.Format(context.Item.Rating)</CellTemplate>
                </TemplateColumn>
            </Columns>
        </MudDataGrid>
    }
    <MudText Typo="Typo.h5" HtmlTag="h2" Class="mt-4 mb-2">Season wins</MudText>
    @if (_participant.SeasonWins.Length == 0)
    {
        <MudText Class="mb-4">No season wins.</MudText>
    }
    else
    {
        <MudDataGrid T="ParticipantSeasonWin" RowClass="sport-accent-row" RowStyleFunc="@((item, _) => SportAccent.RowStyle(item.Sport.Value))" Items="_participant.SeasonWins" Dense="true" Hover="true" Striped="true" Bordered="true" Elevation="1" Class="mb-2">
            <Columns>
                <TemplateColumn Title="Season">
                    <CellTemplate>
                        <MudStack Row="true" AlignItems="AlignItems.Center">
                            <MudImage Src="@SportImage.Url(context.Item.Sport.Value)" Alt="@($"{context.Item.Sport} logo")"
                                      Width="28" Height="22" ObjectFit="ObjectFit.Contain" />
                            <MudLink Href="@($"/seasons/details/{context.Item.SeasonId}")">
                                @($"{context.Item.Sport} {context.Item.Label} ({DateDisplay.Format(context.Item.StartDate)} – {DateDisplay.Format(context.Item.EndDate)})".Trim())
                            </MudLink>
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </MudDataGrid>
    }
    <MudStack Row="true" Spacing="2">
        <MudButton Href="@($"/participants/edit/{_participant.Id}")" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit">Edit</MudButton>
        <MudButton Href="/participants" Variant="Variant.Text">Back to participants</MudButton>
    </MudStack>
}

@code {
    private ParticipantInfo? _participant;
    private bool _loading = true;

    [Parameter]
    public int Id { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _participant = await Service.GetAsync(Id);
        _loading = false;
    }
}